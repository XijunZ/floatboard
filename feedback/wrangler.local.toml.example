# Your own deploy config for the feedback service. Copy to wrangler.local.toml (git ignores it), fill in your values:
#   npx wrangler d1 create floatboard-feedback
#   npx wrangler d1 migrations apply floatboard-feedback --remote --config wrangler.local.toml
#   npx wrangler secret put GITHUB_TOKEN --config wrangler.local.toml   # fine-grained token: Issues read/write on GITHUB_REPO only
#   npx wrangler secret put NTFY_TOPIC --config wrangler.local.toml     # optional: your ntfy topic for alerts
#   npx wrangler deploy --config wrangler.local.toml
# Placeholders only: never commit the real file.

name = "floatboard-feedback"
main = "src/index.ts"
compatibility_date = "2026-10-01"
workers_dev = true
preview_urls = false

[[d1_databases]]
binding = "DB"
database_name = "floatboard-feedback"
database_id = "00000000-0000-0000-0000-000000000000" # yours
migrations_dir = "migrations"

[vars]
GITHUB_REPO = "your-name/floatboard-feedback" # yours: a private repository

[triggers]
crons = ["0 * * * *"]

[observability]
enabled = true
